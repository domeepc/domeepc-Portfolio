---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import About from '../components/About';
import Skills from '../components/Skills';
import Projects from '../components/Projects';
import Timeline from '../components/Timeline';
import Contact from '../components/Contact';
import Preloader from '../components/Preloader';
---

<Layout>
  <Preloader client:load />
  <Navbar client:load baseUrl={import.meta.env.BASE_URL} />
  <main class="relative z-10">
    <Hero client:load />
    <About client:visible={{ rootMargin: "400px" }} />
    <Skills client:visible={{ rootMargin: "400px" }} />
    <Projects client:visible={{ rootMargin: "400px" }} />
    <Timeline client:visible={{ rootMargin: "400px" }} />
    <Contact client:visible={{ rootMargin: "400px" }} />
  </main>
</Layout>
