---
import '../styles/globals.css';
import CustomCursor from '../components/CustomCursor';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Domagoj Milardović — Developer Portfolio',
  description = 'Computer Engineering student and developer from Croatia. Building web apps, embedded systems, and algorithms.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Domagoj Milardović" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}/dm-logo.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-screen antialiased cursor-none overflow-x-hidden">
    <CustomCursor client:load />
    <slot />
  </body>
</html>
